{
  "name": "sessionstack",
  "description": "Several isolated logins to the same site, side by side in one window. Each tab belongs to a session with its own cookies and storage.",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "test:e2e": "wxt build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/bitter": "^5.3.0",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "glass-scroll": "0.2.0",
    "preact": "^11.0.2",
    "tldts": "^7.4.19",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
